# Chave da API do Claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...
# Modelo do agente (opus = melhor olhar de design; sonnet = mais barato)
CLAUDE_MODEL=claude-opus-5-5
# Acesso da equipe: usuario:senha separados por vírgula (ou APP_PASSWORD=senha única)
EQUIPE=danilo:troque-esta-senha,designer:outra-senha
# Pasta onde ficam os jobs (no Cloud Run, monte um bucket aqui)
DATA_DIR=./data
PORT=8080
